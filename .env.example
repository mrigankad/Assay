# ============================================
# Assay - environment template. Copy to .env.
#
# MODELS: you need at least one. Assay detects whatever is here, any
# cloud login on this machine, and local servers (Ollama, LM Studio,
# vLLM...) on start. Full list: docs/PROVIDERS.md
# ============================================

# --- Pick ONE or more (leave the rest blank) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Azure OpenAI (model = your deployment name)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# AWS Bedrock: AWS_PROFILE or access keys, plus a region
AWS_PROFILE=
AWS_REGION=us-east-1
# Google Vertex: run `gcloud auth application-default login`, then
VERTEXAI_PROJECT=
VERTEXAI_LOCATION=us-central1
# Local: Ollama on :11434 etc. are found automatically. Point elsewhere with
OLLAMA_API_BASE=

# --- Optional overrides (LiteLLM model strings) ---
# ASSAY_MODEL=anthropic/claude-sonnet-4-5          # default for every role
# ASSAY_MODEL_PLANNER=groq/llama-3.3-70b-versatile
# ASSAY_MODEL_VERIFIER=gemini/gemini-2.5-pro
# ASSAY_EMBED_MODEL=builtin/bge-small-en-v1.5      # offline, no key needed
# ASSAY_RERANK_MODEL=cohere/rerank-v3.5
# ASSAY_SCAN_LOCAL=1                               # 0 to skip local port probes
# Vendor CLIs with your own login (personal use only, off by default):
# ASSAY_ENABLE_CLAUDE_CODE=1
# ASSAY_ENABLE_CODEX_CLI=1
# ASSAY_ENABLE_GEMINI_CLI=1

APP_NAME=assay-retrieval-engine
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_PORT=8000

# --- Knowledge backend: local (Qdrant hybrid) | foundry_iq (Azure AI Search) | mcp (any MCP server) | mock
KNOWLEDGE_BACKEND=local
KNOWLEDGE_FALLBACK_BACKEND=

# --- MCP: Assay as an MCP server (/mcp) and as a client of other MCP knowledge servers
MCP_SERVER_ENABLED=true
MCP_REQUIRE_AUTH=true
MCP_API_TOKEN=                       # static service token for agent frameworks (tenant-wide read)
MCP_SERVER_URL=                      # KNOWLEDGE_BACKEND=mcp: e.g. https://<svc>.search.windows.net/knowledgebases/<kb>/mcp?api-version=2026-08-01-preview
MCP_TOOL_NAME=knowledge_retrieve     # Foundry IQ: knowledge_base_retrieve
MCP_AUTH_TOKEN=

# --- Access control (principals on every chunk; filters derived from the verified token)
ACL_ENFORCEMENT=true
ACL_TENANT_SCOPING=true
DEFAULT_DOCUMENT_VISIBILITY=tenant   # private | tenant | public
DEFAULT_TENANT_ID=default

# --- Authentication: local (Assay JWTs) | entra (Microsoft Entra ID bearer tokens) | both
AUTH_MODE=local
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=                     # expected audience (api://... or client id)
ENTRA_ADMIN_GROUP=                   # group id whose members get the admin role

# --- NVIDIA NIM, optional (https://build.nvidia.com) -- verify model IDs there; deprecated IDs return 404/410
NVIDIA_API_KEY=                      # optional: NIM is one provider among many
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_LLM_FAST_MODEL=nvidia/nemotron-3-nano-30b-a3b
NVIDIA_LLM_FALLBACK_MODELS=nvidia/llama-3.3-nemotron-super-49b-v1.5,meta/llama-3.1-70b-instruct
NVIDIA_EMBED_MODEL=nvidia/llama-nemotron-embed-1b-v2
NVIDIA_RERANK_MODEL=nvidia/llama-nemotron-rerank-1b-v2
NVIDIA_RERANK_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/llama-nemotron-rerank-1b-v2/reranking
NVIDIA_TIMEOUT=90

# --- Microsoft Foundry IQ / Azure AI Search agentic retrieval (KNOWLEDGE_BACKEND=foundry_iq)
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_API_VERSION=2026-08-01-preview
FOUNDRY_IQ_KNOWLEDGE_BASE=
FOUNDRY_IQ_KNOWLEDGE_SOURCE=
FOUNDRY_IQ_REASONING_EFFORT=low

# --- Relational DB (PostgreSQL in Docker; set USE_SQLITE=true for a zero-dependency local run)
USE_SQLITE=false
SQLITE_PATH=./data/assay.db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass123

# --- Qdrant (server | memory | path)
QDRANT_MODE=server
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=documents
QDRANT_VECTOR_SIZE=384                # starting size only; Assay keeps one collection per embedding size
QDRANT_SPARSE_ENABLED=true

# --- Redis (queue, caching, rate limits). REDIS_ENABLED=false + INGESTION_MODE=inline needs no Redis.
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
INGESTION_MODE=queue

# --- Security
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOW_ANONYMOUS_CHAT=true
DEFAULT_ADMIN_USERNAME=admin
ALLOW_SIGNUP=false                   # after the first admin, people join by invite
DEFAULT_ADMIN_PASSWORD=               # leave empty: the first account you create in the UI becomes admin
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- Retrieval
CHUNK_SIZE=512
CHUNK_OVERLAP=64
CONTEXTUAL_HEADERS=true
TOP_K_RETRIEVAL=24
RERANK_TOP_K=8
MAX_CONTEXT_TOKENS=6144
HYBRID_SEARCH_ENABLED=true
RRF_K=60
ENABLE_RERANKING=true
RERANKER_BACKEND=auto                # auto = best detected rerank provider, else built-in ONNX
MULTI_QUERY_ENABLED=true
MAX_SUB_QUERIES=4
MAX_TOOL_CALLS=4

# --- Ingestion
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,txt,md,html,csv
PARSER_BACKEND=auto
ENABLE_KNOWLEDGE_GRAPH=false
ENABLE_OBJECT_STORAGE=false

# --- Structured data gateway (data.query): read-only NL->SQL over your databases
DATA_GATEWAY_ENABLED=true
# Bootstrap connections here or create them via POST /data/connections (persisted in the DB)
DATA_CONNECTIONS_JSON=
# e.g. [{"id":"sales","name":"SalesDB","dialect":"postgres","url":"env:SALES_DB_URL","allowed_schemas":["public"],"denied_columns":["customers.email"]}]
SALES_DB_URL=
DATA_MAX_SQL_CALLS=3

# --- Connectors (SharePoint/OneDrive, Google Drive, Confluence, S3, web, local folder)
CONNECTOR_SCHEDULER_ENABLED=true
CONNECTOR_SCHEDULER_TICK_SECONDS=60
# connector secrets are referenced as env:VAR in connector settings, e.g. SP_CLIENT_SECRET, GDRIVE_TOKEN, CONFLUENCE_TOKEN
SP_CLIENT_SECRET=
GDRIVE_TOKEN=
CONFLUENCE_TOKEN=

# --- Retrieval tiers
ADAPTIVE_RETRIEVAL_ENABLED=true      # rewrite + retry when the reranker finds nothing convincing
RELEVANCE_GATE_THRESHOLD=0.25
SUMMARY_CHUNKS_ENABLED=true          # one document-outline chunk per document for overview questions

# --- Observability / safety
PERSIST_TRACES=true
TRACING_ENABLED=false
OTLP_PROTOCOL=grpc                   # grpc (Jaeger/Tempo/collector) | http (Langfuse, Phoenix)
OTLP_ENDPOINT=http://jaeger:4317     # Langfuse: https://cloud.langfuse.com/api/public/otel/v1/traces
OTLP_HEADERS=                        # Langfuse: Authorization=Basic <base64(pk:sk)>
GUARDRAILS_ENABLED=true
RAGAS_EVALUATION_ENABLED=false

# --- Web research (off by default) ---
# off: never | ask: only when "Web" is ticked on a question | auto: also when documents have nothing
WEB_MODE=off
# One search backend (first set wins). SearXNG is free and self-hosted.
TAVILY_API_KEY=
BRAVE_API_KEY=
EXA_API_KEY=
SEARXNG_URL=
# Optional domain rules (comma separated); allowlist empty = any domain not blocked
WEB_ALLOWED_DOMAINS=
WEB_BLOCKED_DOMAINS=
WEB_MAX_PAGES=3
WEB_RESPECT_ROBOTS=true
